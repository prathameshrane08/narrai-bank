  "openapi": "3.1.0",
  "info": {
    "title": "NarrAI API",
    "description": "Verified financial storytelling for banks: code calculates every number, the AI only narrates it.\n\n**Bank integration** endpoints are called server-to-server with the bank's `X-NarrAI-API-Key`. **Customer app** endpoints need a session token (`Authorization: Bearer …`) that the bank obtains from `POST /api/sessions`. See docs/integration-guide.md.",
    "version": "0.4.0"
  },
